#!/usr/bin/make -f
export PYBUILD_DESTDIR=debian/tmp
%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_install:
	dh_install
	install -D -m 640 debian/conf.stub debian/dmj-vault-apps-admin/etc/dmj-vault-apps-admin/conf
	install -D -m 600 debian/key.stub debian/dmj-vault-apps-admin/etc/dmj-vault-apps-admin/key

override_dh_fixperms:
	dh_fixperms -Xetc/dmj-vault-apps-admin/key

override_dh_python3:
	dh_python3
	for pkg_dir in debian/dmj-vault-apps-admin/usr/lib/python3*/dist-packages/dmj_vault; do \
		if [ -d "$$pkg_dir" ]; then \
			python3 -m compileall -b "$$pkg_dir"; \
			find "$$pkg_dir" -name '*.py' -delete; \
			find "$$pkg_dir" -type d -name '__pycache__' -exec rm -rf {} + 2>/dev/null || true; \
		fi; \
	done
